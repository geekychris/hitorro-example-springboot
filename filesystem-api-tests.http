###############################################################################

### Health Check
GET {{baseUrl}}/actuator/health
Accept: application/json

###

### Application Info
GET {{baseUrl}}/actuator/info
Accept: application/json

###

### Metrics
GET {{baseUrl}}/actuator/metrics
Accept: application/json

###############################################################################
### NOTES
###############################################################################

# File System Base Path: ./data/files (relative to application working directory)
#
# To view created files:
#   cd hitorro-example-springboot/data/files
#   ls -la
#
# To clean up test files:
#   rm -rf hitorro-example-springboot/data/files/test
#
# Swagger UI: http://localhost:8080/swagger-ui.html
# OpenAPI Spec: http://localhost:8080/api-docs
# H2 Console: http://localhost:8080/h2-console
#
# JAR and S3 file systems:
#   - JAR filesystem endpoints: /api/filesystem/jar/*
#   - S3 filesystem endpoints: /api/filesystem/s3/* (see below)
#   - Configure in application.yml to enable

###############################################################################
### 9. S3-COMPATIBLE FILE SYSTEM (MinIO, AWS S3, Wasabi, etc.)
###############################################################################
###
### Prerequisites:
### 1. MinIO running: docker run -p 9000:9000 -p 9001:9001 ...
### 2. Configure in application.yml:
###    hitorro.filesystem.s3.enabled=true
###    hitorro.filesystem.s3.endpoint=http://localhost:9000
###    hitorro.filesystem.s3.bucket=test
###    hitorro.filesystem.s3.access-key=minioadmin
###    hitorro.filesystem.s3.secret-key=minioadmin
###

### List Files in S3 Root
GET {{filesystemApi}}/s3/list?path=/
Accept: application/json

> {%
    client.test("Request executed", function() {
        client.assert(response.status === 200 || response.status === 503, 
            "Expected 200 (OK) or 503 (not configured)");
    });
    
    if (response.status === 200) {
        client.test("Response is an array", function() {
            client.assert(Array.isArray(response.body), "Response is not an array");
        });
    }
%}

### List Files in S3 Directory
GET {{filesystemApi}}/s3/list?path=documents
Accept: application/json

### Read File from S3
GET {{filesystemApi}}/s3/read/test.txt
Accept: text/plain

> {%
    client.test("Request executed", function() {
        client.assert(response.status === 200 || response.status === 404 || response.status === 503,
            "Expected 200 (OK), 404 (not found), or 503 (not configured)");
    });
%}

### Write File to S3
POST {{filesystemApi}}/s3/write
Content-Type: application/json

{
  "path": "test/demo.txt",
  "content": "Hello from S3!\nThis file was created via REST API."
}

> {%
    client.test("Request executed", function() {
        client.assert(response.status === 200 || response.status === 503,
            "Expected 200 (OK) or 503 (not configured)");
    });
%}

### Write JSON File to S3
POST {{filesystemApi}}/s3/write
Content-Type: application/json

{
  "path": "data/config.json",
  "content": "{\"environment\": \"development\", \"version\": \"1.0.0\"}"
}

### Read Back the JSON File
GET {{filesystemApi}}/s3/read/data/config.json
Accept: text/plain

### Write Larger File to S3
POST {{filesystemApi}}/s3/write
Content-Type: application/json

{
  "path": "logs/application.log",
  "content": "2026-01-14 INFO  Application started\n2026-01-14 INFO  Processing request\n2026-01-14 INFO  Request completed\n2026-01-14 WARN  High memory usage detected\n2026-01-14 INFO  Cache cleared"
}

###############################################################################
### End of Tests
###############################################################################
