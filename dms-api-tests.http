### Document Management System (DMS) API Tests
### Base URL
@baseUrl = http://localhost:8080/api/dms
@contentType = application/json

### ============================================================================
### Document CRUD Operations
### ============================================================================

### 1. Create a new document
POST {{baseUrl}}/documents
Content-Type: {{contentType}}

{
  "title": "Annual Report 2026",
  "note": "Q4 2026 Annual Report",
  "creator": "john.doe",
  "realm": "default",
  "categories": [
    {
      "domain": "type",
      "value": "report"
    },
    {
      "domain": "department",
      "value": "finance"
    },
    {
      "domain": "status",
      "value": "draft"
    }
  ]
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 201, "Response status is not 201");
    });
    client.test("Response has document ID", function() {
        var data = response.body;
        client.assert(data.id !== null, "Document ID is null");
        client.global.set("documentId", data.id);
    });
    client.test("Document has correct title", function() {
        var data = response.body;
        client.assert(data.title === "Annual Report 2026", "Title mismatch");
    });
    client.test("Document has categories", function() {
        var data = response.body;
        client.assert(data.categories.length > 0, "No categories found");
    });
%}

###

### 2. Get document by ID
GET {{baseUrl}}/documents/{{documentId}}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Document returned", function() {
        var data = response.body;
        client.assert(data.id == client.global.get("documentId"), "Wrong document ID");
    });
%}

###

### 3. Update document
PUT {{baseUrl}}/documents/{{documentId}}
Content-Type: {{contentType}}

{
  "title": "Annual Report 2026 - Final",
  "note": "Final version of Q4 2026 Annual Report"
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Title updated", function() {
        var data = response.body;
        client.assert(data.title === "Annual Report 2026 - Final", "Title not updated");
    });
%}

###

### 4. Delete document (cleanup - run at end)
# DELETE {{baseUrl}}/documents/{{documentId}}

