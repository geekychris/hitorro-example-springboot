### ============================================================================
### Version Management
### ============================================================================

### 7. Create new version
POST {{baseUrl}}/documents/{{documentId}}/version
Content-Type: {{contentType}}

{
  "note": "Version 1.1 - Added executive summary"
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 201, "Response status is not 201");
    });
    client.test("New version created", function() {
        var data = response.body;
        client.assert(data.id !== null, "Version ID is null");
        client.assert(data.id != client.global.get("documentId"), "Same ID as original");
        client.global.set("versionId", data.id);
    });
    client.test("Version has parent reference", function() {
        var data = response.body;
        client.assert(data.parentVersionId !== null, "No parent version ID");
    });
%}

###

### 8. Get version history
GET {{baseUrl}}/documents/{{documentId}}/versions

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Version history returned", function() {
        var data = response.body;
        client.assert(Array.isArray(data), "Response is not an array");
        client.assert(data.length > 0, "No versions found");
    });
%}

