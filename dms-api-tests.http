### ============================================================================
### Complex Scenarios
### ============================================================================

### 20. Create document with all properties
POST {{baseUrl}}/documents
Content-Type: {{contentType}}

{
  "title": "Comprehensive Document Test",
  "note": "Testing all document properties",
  "creator": "test.user",
  "realm": "test-realm",
  "categories": [
    {"domain": "type", "value": "test"},
    {"domain": "status", "value": "active"},
    {"domain": "priority", "value": "medium"},
    {"domain": "visibility", "value": "internal"}
  ]
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 201, "Response status is not 201");
    });
    client.test("All properties set", function() {
        var data = response.body;
        client.assert(data.title === "Comprehensive Document Test", "Title mismatch");
        client.assert(data.creator === "test.user", "Creator mismatch");
        client.assert(data.realm === "test-realm", "Realm mismatch");
        client.assert(data.categories.length > 0, "No categories");
    });
    client.global.set("testDocId", data.id);
%}

###

### 21. Query with multiple filters
POST {{baseUrl}}/documents/query
Content-Type: {{contentType}}

{
  "title": "Document",
  "creator": "test.user",
  "realm": "test-realm",
  "orderBy": "modifiedDate",
  "descending": true,
  "maxResults": 10
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Filtered results returned", function() {
        var data = response.body;
        client.assert(Array.isArray(data), "Response is not an array");
        if (data.length > 0) {
            client.assert(data[0].realm === "test-realm", "Realm filter failed");
        }
    });
%}

