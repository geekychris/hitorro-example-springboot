### 5. Add category to document
POST {{baseUrl}}/documents/{{documentId}}/categories
Content-Type: {{contentType}}

{
  "domain": "priority",
  "value": "high"
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Response indicates success", function() {
        var data = response.body;
        client.assert(data.status === "success", "Status is not success");
    });
%}

###

### 6. Remove category from document
DELETE {{baseUrl}}/documents/{{documentId}}/categories?domain=priority&value=high

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

