### ============================================================================
### Performance Tests
### ============================================================================

### 28. Large query - retrieve maximum documents
POST {{baseUrl}}/documents/query
Content-Type: {{contentType}}

{
  "maxResults": 1000,
  "orderBy": "modifiedDate",
  "descending": true
}

> {%
    client.test("Request executed", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Results limited appropriately", function() {
        var data = response.body;
        client.assert(Array.isArray(data), "Response is not an array");
        client.assert(data.length <= 1000, "Too many results returned");
    });
%}

