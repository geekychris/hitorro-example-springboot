### 23. Get complete version tree
GET {{baseUrl}}/documents/{{testDocId}}/versions

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Multiple versions exist", function() {
        var data = response.body;
        client.assert(data.length >= 1, "Expected at least 1 version");
    });
    client.test("Versions are ordered", function() {
        var data = response.body;
        for (var i = 0; i < data.length - 1; i++) {
            // Check that versions have increasing IDs or proper linkage
            client.assert(data[i].id !== null, "Version ID is null");
        }
    });
%}

